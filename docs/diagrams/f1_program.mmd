flowchart TD
  A([Початок]) --> B[/Завантаження наборів 5, 10, 20 точок/]
  B --> C[Ініціалізація стану: n = 5, режим «Усі», m = 2]
  C --> D["recompute(): побудова моделі для набору n"]
  D --> E["Лагранж: makeLagrange(x, y)"]
  E --> F["Ньютон: dividedDifferences(x, y)"]
  F --> G["МНК: leastSquares(x, y, m) — QR Хаусхолдера"]
  G --> H["Метрики: SSE, RMSE, R², max|r|, cond₂(A)"]
  H --> I["frame(): побудова сцени, автомасштаб, малювання"]
  I --> J{Подія користувача?}
  J -- "Зміна n / m / даних" --> D
  J -- "Зміна режиму" --> I
  J -- "Анімувати" --> K["Запуск фаз анімації (Лагранж → МНК)"]
  K --> I
  J -- "Закриття сторінки" --> Z([Кінець])
