flowchart TD
  A(["Початок leastSquares(xs, ys, m)"]) --> B{"Дані коректні і m ≤ n − 1 ?"}
  B -- ні --> ERR[/"Помилка RangeError"/] --> Z([Кінець])
  B -- так --> C["Нормалізація: c = (x₀ + xₙ)/2, h = (xₙ − x₀)/2, tᵢ = (xᵢ − c)/h"]
  C --> D["Дизайн-матриця A[i][j] = tᵢʲ, j = 0..m"]
  D --> E["k = 0"]
  E --> F{"k ≤ m ?"}
  F -- так --> G["v = A[k..n−1][k] − α·e₁, α = −sign(A[k][k])·‖·‖"]
  G --> H["A = H·A, b = H·b, де H = I − 2vvᵀ/(vᵀv)"]
  H --> I["k = k + 1"]
  I --> F
  F -- ні --> J["Зворотна підстановка: R·θ = (Qᵀb)₀..ₘ"]
  J --> K["ŷᵢ = Σ θⱼ tᵢʲ (Горнер), rᵢ = yᵢ − ŷᵢ"]
  K --> L["SSE, RMSE, R², max|r|, cond₂(A)"]
  L --> R[/"Повернути θ, коефіцієнти за x, fn, ŷ, r, метрики"/]
  R --> Z
