flowchart TD
  A(["Початок lagrange(xs, ys, x)"]) --> B["s = 0; k = 0"]
  B --> C{"k < n ?"}
  C -- ні --> R[/"Повернути s"/]
  R --> Z([Кінець])
  C -- так --> D["L = 1; j = 0"]
  D --> E{"j < n ?"}
  E -- так --> F{"j ≠ k ?"}
  F -- так --> G["L = L · (x − xs[j]) / (xs[k] − xs[j])"]
  F -- ні --> H
  G --> H["j = j + 1"]
  H --> E
  E -- ні --> I["s = s + ys[k] · L"]
  I --> J["k = k + 1"]
  J --> C
