flowchart TD
  A(["frame(ts) — кадр requestAnimationFrame"]) --> B["dt = ts − lastTs"]
  B --> C{"Анімація активна?"}
  C -- так --> D["t = t + dt · rate · speed"]
  D --> E{"t ≥ end ?"}
  E -- так --> F{"Є наступна фаза?"}
  F -- так --> G["Почати наступну фазу (МНК)"]
  F -- ні --> H["anim = null"]
  E -- ні --> S
  G --> S
  H --> S
  C -- ні --> S["buildScene(): видимі криві, вузли, частки залишків"]
  S --> T["target = computeBounds(точки, криві): min/max по 300 відліках кожної кривої + 3 % / 12 % відступу"]
  T --> U["bounds = bounds + (target − bounds)·(1 − e^(−10·dt))"]
  U --> V["Малювання: сітка й осі → криві → залишки → вузли → підказка"]
  V --> W["Діаграма залишків (симетрична шкала ±1.25·max|r|)"]
  W --> X{"Рух триває?"}
  X -.- N["анімація активна або межі<br/>ще не досягли цілі"]
  X -- так --> Y["requestAnimationFrame(frame)"]
  X -- ні --> Z([Очікування подій])
  Y --> Z2([Кінець кадру])
